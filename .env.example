# Copy to .env and fill in. Never commit .env.

# Sanity project (find both at https://www.sanity.io/manage). Not secret.
SANITY_PROJECT_ID=
SANITY_DATASET=production

# Public site address, no trailing slash. Used for canonical URLs and the sitemap.
SITE_URL=https://nauyana.id

# Site address that the Studio's "Preview on site" links open (use http://localhost:3000 locally).
SANITY_STUDIO_SITE_URL=https://nauyana.id
